# Environment template for Docker Compose deployments (compose.yaml).
# Copy to .env.docker before running: docker compose --env-file .env.docker up --build

# Required: Base64-encoded 256-bit secret (run: openssl rand -base64 32)
ATTACHMENT_TOKEN_SECRET=

# Azure Storage account name; leave empty to disable attachment uploads.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=chat-attachments

# Optional Service Principal authentication. Leave empty to use Managed Identity / az login.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Local web port.
CHATMATCH_PORT=3001

# Redis is started by Docker Compose and must stay enabled for upload quotas.
# Override REDIS_URL only when connecting to an external Redis-compatible service.
# REDIS_URL=redis://redis:6379

# Groq API cho Trợ lý Lumi (tùy chọn). Để trống để dùng kịch bản offline.
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b
