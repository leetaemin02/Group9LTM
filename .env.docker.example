# Azure Blob Storage settings. Leave account name blank to run without uploads.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=chat-attachments
ATTACHMENT_TOKEN_SECRET=

# Optional service principal credentials for Azure access from inside Docker.
# Do not commit the real values in this file or share them.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Tùy chọn bỏ qua kiểm tra Defender tags (hữu ích khi tài khoản chưa bật Defender for Storage)
SKIP_MALWARE_SCAN=false

# Local web port.
CHATMATCH_PORT=3001
