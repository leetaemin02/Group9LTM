# ─────────────────────────────────────────────────────────────
# WebSocket ChatMatch – Cấu hình môi trường (Environment Variables)
# ─────────────────────────────────────────────────────────────

# Cổng lắng nghe của HTTP / WebSocket Server (mặc định: 3001)
PORT=3001

# Bật hàng đợi ghép cặp nguyên tử, bộ đếm online và Pub/Sub nhiều server/process
# Đặt true khi triển khai nhiều instance; Redis phải sẵn sàng để tìm người/chat.
# false: Chạy một instance với hàng đợi và trạng thái in-memory.
USE_REDIS=false

# URL Redis (dùng endpoint primary của Redis/Redis-compatible service)
REDIS_URL=redis://127.0.0.1:6379

# Google Web Risk Lookup API (tắt nếu để trống).
# Tạo API key trong Google Cloud, bật Web Risk API và giới hạn key chỉ dùng API này.
# URL trong tin nhắn sẽ được gửi tới Google để kiểm tra khi biến này được cấu hình.
GOOGLE_WEB_RISK_API_KEY=

# Azure Blob Storage attachments (disabled if AZURE_STORAGE_ACCOUNT_NAME is empty)
# Uses DefaultAzureCredential (az login locally / Managed Identity in Azure); no storage key in the app.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=chat-attachments
# Optional custom Blob endpoint; defaults to https://<account>.blob.core.windows.net
AZURE_STORAGE_BLOB_ENDPOINT=
# Required on every app instance; generate a strong random value and store it as a secret.
ATTACHMENT_TOKEN_SECRET=
# Per-process concurrent upload limit (default: 4; tune to instance memory/network capacity).
MAX_CONCURRENT_ATTACHMENT_UPLOADS=4
# Fail-closed wait limit for Defender for Storage scan results (default: 180000 ms).
ATTACHMENT_SCAN_TIMEOUT_MS=180000
