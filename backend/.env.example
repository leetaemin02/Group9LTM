# ─────────────────────────────────────────────────────────────
# WebSocket ChatMatch – Cấu hình môi trường (Environment Variables)
# ─────────────────────────────────────────────────────────────

# Cổng lắng nghe của HTTP / WebSocket Server (mặc định: 3001)
PORT=3001

# Số thành viên tối đa cho mỗi phòng trò chuyện nhóm ẩn danh (mặc định: 60, hợp lệ: 3..100)
MAX_GROUP_MEMBERS=60

# Số người chơi tối đa cho mỗi phòng game nhiều người ẩn danh (mặc định: 10, hợp lệ: 2..10)
MAX_GAME_ROOM_PLAYERS=10

# Số tin nhắn gần nhất được giữ lại khi 2 người đồng ý "Giữ kết nối" 1-1 (mặc định: 40, hợp lệ: 30..50)
MAX_PAIR_HISTORY=40

# Bật hàng đợi ghép cặp nguyên tử, bộ đếm online và Pub/Sub nhiều server/process
# Đặt true khi triển khai nhiều instance; Redis phải sẵn sàng để tìm người/chat.
# false: Chạy một instance với hàng đợi và trạng thái in-memory.
USE_REDIS=true

# URL Redis (dùng endpoint primary của Redis/Redis-compatible service)
REDIS_URL=redis://127.0.0.1:6379

# Google Web Risk Lookup API (tắt nếu để trống).
# Tạo API key trong Google Cloud, bật Web Risk API và giới hạn key chỉ dùng API này.
# URL trong tin nhắn sẽ được gửi tới Google để kiểm tra khi biến này được cấu hình.
GOOGLE_WEB_RISK_API_KEY=

# Azure Blob Storage attachments (disabled if AZURE_STORAGE_ACCOUNT_NAME is empty)
# Uses DefaultAzureCredential (az login locally / Managed Identity in Azure); no storage key in the app.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=chat-attachments
# Optional custom Blob endpoint; defaults to https://<account>.blob.core.windows.net
AZURE_STORAGE_BLOB_ENDPOINT=
# Required on every app instance; generate a strong random value and store it as a secret.
ATTACHMENT_TOKEN_SECRET=
# Per-process concurrent upload limit (default: 4; tune to instance memory/network capacity).
MAX_CONCURRENT_ATTACHMENT_UPLOADS=4
# Fail-closed wait limit for Defender for Storage scan results (default: 180000 ms).
ATTACHMENT_SCAN_TIMEOUT_MS=180000
# Đặt true nếu vùng Storage Account chưa hỗ trợ Defender for Storage (vd: malaysiawest) hoặc chưa bật On-upload scan.
SKIP_MALWARE_SCAN=false

# Groq API cho Trợ lý Lumi (tùy chọn). Để trống = Lumi dùng kịch bản trả lời offline.
# Tạo key tại https://console.groq.com/keys – KHÔNG commit key, chỉ đặt qua biến môi trường/secret.
GROQ_API_KEY=
# Model nhỏ cho câu ngắn/tán gẫu và model lớn cho câu dài/tâm sự sâu.
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b
# Thời gian chờ tối đa mỗi lần gọi Groq (ms); quá hạn Lumi tự trả lời bằng kịch bản offline.
GROQ_TIMEOUT_MS=8000

# ─── Bảo mật & Chống lạm dụng (Security Hardening) ───────────────────────────
# Chỉ bật TRUST_PROXY=true khi chạy sau Reverse Proxy tin cậy (Nginx, Cloudflare, Azure App Service)
TRUST_PROXY=false
# Số hop reverse proxy phía trước server khi TRUST_PROXY=true (mặc định: 1)
TRUST_PROXY_HOPS=1
# Danh sách Origin được phép kết nối WebSocket (phân tách bằng dấu phẩy).
# Để trống = mặc định bắt buộc Same-Origin theo header Host (chống CSWSH).
ALLOWED_ORIGINS=
# Bắt buộc mọi kết nối WebSocket phải có header Origin (khuyến nghị true ở production)
REQUIRE_ORIGIN=false
# Giới hạn số phòng nhóm & phòng game đồng thời trong RAM (chống DoS cạn bộ nhớ)
MAX_ACTIVE_GROUPS=500
MAX_ACTIVE_GAME_ROOMS=300
